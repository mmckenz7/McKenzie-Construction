{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mckenzieconstruction.com/schemas/ai-estimator/extraction-v0.schema.json",
  "title": "McKenzie OS AI Estimator Extraction V0",
  "description": "Provider-neutral, non-monetary shadow estimate extraction contract.",
  "$comment": "Monetary, pricing, structural-approval, code-compliance, and engineering-determination fields are prohibited. Application validation performs a recursive prohibited-key scan in addition to this exact schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sourceAssetIds",
    "summary",
    "facts",
    "sections",
    "unknowns",
    "clarifyingQuestions",
    "warnings"
  ],
  "properties": {
    "schemaVersion": {
      "const": "ai-estimator-extraction-v0"
    },
    "sourceAssetIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/uuid"
      }
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "facts": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "$ref": "#/$defs/fact"
      }
    },
    "sections": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/section"
      }
    },
    "unknowns": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/unknown"
      }
    },
    "clarifyingQuestions": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/question"
      }
    },
    "warnings": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/warning"
      }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "localId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "shortText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "longText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000
    },
    "nullableShortText": {
      "type": ["string", "null"],
      "maxLength": 500
    },
    "nullableLongText": {
      "type": ["string", "null"],
      "maxLength": 5000
    },
    "confidence": {
      "type": "string",
      "pattern": "^(?:0(?:\\.\\d{1,4})?|1(?:\\.0{1,4})?)$"
    },
    "verificationState": {
      "enum": ["verified", "high_confidence", "estimated", "unverified"]
    },
    "modelVerificationState": {
      "enum": ["high_confidence", "estimated", "unverified"]
    },
    "sourceType": {
      "enum": ["manual", "spoken", "drawing", "LiDAR", "Matterport", "visual_estimate", "derived"]
    },
    "dimension": {
      "enum": ["count", "length", "area", "volume", "weight", "angle", "duration", "rate", "other"]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectTypeCandidate", "plainLanguageScope", "overallConfidence"],
      "properties": {
        "projectTypeCandidate": {
          "$ref": "#/$defs/nullableShortText"
        },
        "plainLanguageScope": {
          "$ref": "#/$defs/nullableLongText"
        },
        "overallConfidence": {
          "$ref": "#/$defs/modelVerificationState"
        }
      }
    },
    "boundingBox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assetId",
        "transcriptSegmentId",
        "startMs",
        "endMs",
        "pageNumber",
        "boundingBox",
        "externalMeasurementId",
        "excerpt"
      ],
      "properties": {
        "assetId": {
          "$ref": "#/$defs/uuid"
        },
        "transcriptSegmentId": {
          "anyOf": [
            { "$ref": "#/$defs/uuid" },
            { "type": "null" }
          ]
        },
        "startMs": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 86400000
        },
        "endMs": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 86400000
        },
        "pageNumber": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 10000
        },
        "boundingBox": {
          "anyOf": [
            { "$ref": "#/$defs/boundingBox" },
            { "type": "null" }
          ]
        },
        "externalMeasurementId": {
          "type": ["string", "null"],
          "maxLength": 500
        },
        "excerpt": {
          "type": ["string", "null"],
          "maxLength": 1000
        }
      }
    },
    "derivation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formula", "version", "inputFactIds"],
      "properties": {
        "formula": {
          "$ref": "#/$defs/shortText"
        },
        "version": {
          "$ref": "#/$defs/shortText"
        },
        "inputFactIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/localId"
          }
        }
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "semanticKey",
        "label",
        "value",
        "unit",
        "dimension",
        "sourceType",
        "verificationState",
        "confidence",
        "evidence",
        "contradictionGroupId",
        "derivation"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/localId"
        },
        "kind": {
          "enum": ["measurement", "scope", "condition", "material", "exclusion", "assumption", "other"]
        },
        "semanticKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "label": {
          "$ref": "#/$defs/shortText"
        },
        "value": {
          "type": ["string", "boolean", "null"],
          "maxLength": 2000
        },
        "unit": {
          "type": ["string", "null"],
          "maxLength": 100
        },
        "dimension": {
          "$ref": "#/$defs/dimension"
        },
        "sourceType": {
          "$ref": "#/$defs/sourceType"
        },
        "verificationState": {
          "$ref": "#/$defs/modelVerificationState"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "evidence": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "contradictionGroupId": {
          "anyOf": [
            { "$ref": "#/$defs/localId" },
            { "type": "null" }
          ]
        },
        "derivation": {
          "anyOf": [
            { "$ref": "#/$defs/derivation" },
            { "type": "null" }
          ]
        }
      }
    },
    "quantityCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit", "sourceFactIds", "verificationState"],
      "properties": {
        "value": {
          "type": ["string", "null"],
          "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d{1,4})?$",
          "maxLength": 32
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "sourceFactIds": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/localId"
          }
        },
        "verificationState": {
          "$ref": "#/$defs/modelVerificationState"
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "itemTypeCandidate",
        "categoryCandidate",
        "customerDescriptionCandidate",
        "internalDescriptionCandidate",
        "quantityCandidate",
        "scopeFactIds",
        "measurementFactIds",
        "unknownIds"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/localId"
        },
        "itemTypeCandidate": {
          "enum": ["standard", "allowance"]
        },
        "categoryCandidate": {
          "enum": ["material", "labor", "subcontractor", "equipment", "permit", "dumpster", "delivery", "allowance", "other"]
        },
        "customerDescriptionCandidate": {
          "$ref": "#/$defs/shortText"
        },
        "internalDescriptionCandidate": {
          "$ref": "#/$defs/nullableLongText"
        },
        "quantityCandidate": {
          "$ref": "#/$defs/quantityCandidate"
        },
        "scopeFactIds": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/localId"
          }
        },
        "measurementFactIds": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/localId"
          }
        },
        "unknownIds": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/localId"
          }
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "customerDescriptionCandidate", "evidenceFactIds", "items"],
      "properties": {
        "id": {
          "$ref": "#/$defs/localId"
        },
        "name": {
          "$ref": "#/$defs/shortText"
        },
        "customerDescriptionCandidate": {
          "$ref": "#/$defs/nullableLongText"
        },
        "evidenceFactIds": {
          "type": "array",
          "maxItems": 200,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/localId"
          }
        },
        "items": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "$ref": "#/$defs/item"
          }
        }
      }
    },
    "unknown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "semanticKey", "description", "blocksQuantity", "blocksPricing", "evidence"],
      "properties": {
        "id": {
          "$ref": "#/$defs/localId"
        },
        "semanticKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "description": {
          "$ref": "#/$defs/longText"
        },
        "blocksQuantity": {
          "type": "boolean"
        },
        "blocksPricing": {
          "type": "boolean"
        },
        "evidence": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "question", "reason", "resolvesUnknownIds", "priority"],
      "properties": {
        "id": {
          "$ref": "#/$defs/localId"
        },
        "question": {
          "$ref": "#/$defs/shortText"
        },
        "reason": {
          "$ref": "#/$defs/longText"
        },
        "resolvesUnknownIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/localId"
          }
        },
        "priority": {
          "enum": ["blocking", "important", "optional"]
        }
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "evidenceSegmentIds"],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "message": {
          "$ref": "#/$defs/longText"
        },
        "evidenceSegmentIds": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/uuid"
          }
        }
      }
    }
  }
}
