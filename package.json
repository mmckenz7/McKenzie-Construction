{
  "name": "mckenzie-construction",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run migration:check",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "migration:check": "node scripts/check-migration-ledger.mjs",
    "sandbox:prepare": "node scripts/prepare-local-sandbox.mjs",
    "sandbox:start": "supabase --workdir .local-sandbox start",
    "sandbox:reset": "supabase --workdir .local-sandbox db reset",
    "sandbox:seed": "node scripts/local-sandbox-seed.mjs",
    "sandbox:verify": "node scripts/verify-local-sandbox.mjs",
    "sandbox:stop": "supabase --workdir .local-sandbox stop"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.8",
    "next": "^16.3.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "svix": "^1.99.1",
    "twilio": "^5.13.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.16.0",
    "eslint-config-next": "^16.3.0",
    "postcss": "^8.5.26",
    "supabase": "^2.111.0",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.8.0"
  }
}
