{
  "name": "@mckenzie/site-map-core",
  "version": "0.0.0",
  "private": true,
  "description": "Read-only site-map contracts, local-ground registration, and an isolated Google presentation adapter.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CONSUMER_CONTRACT.md"
  ],
  "sideEffects": false,
  "scripts": {
    "boundary": "node scripts/check-boundary.mjs",
    "build": "../../node_modules/.bin/tsc -p tsconfig.build.json",
    "typecheck": "../../node_modules/.bin/tsc -p tsconfig.build.json --noEmit",
    "test": "npm run boundary && npm run build && node --test tests/*.test.mjs"
  }
}
